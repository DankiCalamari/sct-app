# SCT — .env.example — copy this file to .env before running.
# Every variable is optional; the defaults shown below are the safe, working
# values for a fresh deploy. Override only what you need.
#
# Local mode acts as a demo logger: emails are written to data/emails/ instead
# of being sent, and demo users admin/tech/viewer are seeded on first run.
#
# NOTE: In Docker you normally do not copy this file into the image. Instead
# place a .env next to docker-compose.yml and set the values there (compose
# reads .env automatically). The app also loads sct-app/.env at startup.

# --------------------------------------------------------------------------- #
# MySQL connection (used for DB_ENGINE=mysql)
# --------------------------------------------------------------------------- #
# Engine: mysql (default) or postgres (postgres support not yet implemented)
SCT_DB_ENGINE=mysql
# DB_HOST: database host. In docker-compose with the sibling service it is the
# service name "sct-mysql"; on the host it is 127.0.0.1 (or the container IP).
SCT_DB_HOST=127.0.0.1
SCT_DB_PORT=3306
# DB_USER / DB_PASSWORD / DB_NAME: DB user, password, database name
SCT_DB_USER=sct
SCT_DB_PASSWORD=change-me
SCT_DB_NAME=sct

# --------------------------------------------------------------------------- #
# App behaviour
# --------------------------------------------------------------------------- #
SCT_PORT=8080
# Session signing key. Change in production; the app will work with this default
# but session cookies must be regenerated on rollout (use a long random string).
SCT_SECRET_KEY=change-me-in-prod

# --------------------------------------------------------------------------- #
# Authentication
# --------------------------------------------------------------------------- #
# local  = seeded demo users  (admin/tech/viewer)
# authentik = Authentik OIDC SSO (requires authentik env vars below)
SCT_AUTH_MODE=local

# Authentik OIDC (only used when SCT_AUTH_MODE=authentik)
# AUTHNIK_URL=https://authentik.example.com/application/oauth2
# AUTHNIK_CLIENT_ID=
# AUTHNIK_CLIENT_SECRET=
# AUTHNIK_CALLBACK_URL=https://app.example.com/auth/authentik/callback
# AUTHNIK_ADMIN_GROUP=sct-admins
# AUTHNIK_TECH_GROUP=sct-techs

# --------------------------------------------------------------------------- #
# Email
# --------------------------------------------------------------------------- #
# local = write to data/emails/ + record in-app (safe for test harness)
# smtp = send via SMTP
SCT_EMAIL_METHOD=local
# SCT_SMTP_HOST=smtp.example.com
# SCT_SMTP_PORT=587
# SCT_SMTP_USER=
# SCT_SMTP_PASSWORD=
# SCT_SMTP_USE_TLS=1

# --------------------------------------------------------------------------- #
# Hnry integration (Zapier bridge by default; no token stored)
# --------------------------------------------------------------------------- #
# SCT_HNRY_WEBHOOK_URL=
# SCT_HNRY_WEBHOOK_SECRET=

# --------------------------------------------------------------------------- #
# File uploads
# --------------------------------------------------------------------------- #
# MAX_CONTENT_LENGTH=25MB
# ALLOWED_UPLOAD_EXT=.jpg .jpeg .png .gif .webp .heic .heif .pdf .doc .docx
#                     .txt .htm .html
